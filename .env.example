# ===== ค่าที่ต้องตั้งใน Vercel (Settings > Environment Variables) =====

# 1) Gemini API Key (ฟรี) - ขอได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=ใส่คีย์ของคุณที่นี่

# (ไม่บังคับ) เลือกโมเดล Gemini — ค่าเริ่มต้น gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# 2) รหัสผ่านเข้าใช้งานโปรแกรม (ตามที่ขอ = 044357246)
NEXT_PUBLIC_APP_PASSWORD=044357246

# 3) (ไม่บังคับ) Supabase สำหรับบันทึกงานที่ทำไว้
#    ขอได้ที่ https://supabase.com  > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
